{
  "name": "qa-automation-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "E2E and API test automation framework covering SauceDemo and Restful-Booker, built with Playwright and TypeScript.",
  "scripts": {
    "pretest": "bddgen",
    "test": "playwright test",
    "test:saucedemo": "playwright test --project=saucedemo",
    "test:saucedemo-bdd": "bddgen && playwright test --project=saucedemo-bdd",
    "test:restful-booker": "playwright test --project=restful-booker",
    "test:crm": "playwright test --project=crm",
    "test:ai-assistant": "playwright test --project=ai-assistant",
    "test:headed": "playwright test --project=saucedemo --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "start:ai-assistant": "node apps/ai-assistant/server.ts",
    "start:crm": "npm --prefix apps/crm start -- --port 4300",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^1.8.3",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
