{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@saucedemo/*": ["src/saucedemo/*"],
      "@crm/*": ["src/crm/*"],
      "@restful-booker/*": ["src/restful-booker/*"],
      "@ai-assistant/*": ["src/ai-assistant/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.ts",
    "tools/**/*.ts",
    "apps/ai-assistant/**/*.ts",
    "playwright.config.ts"
  ]
}
